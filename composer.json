{
    "name": "baconfy/core",
    "description": "Core module system for Baconfy.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "laravel/pint": "^1.13",
        "larastan/larastan": "^3.9",
        "fakerphp/faker": "^1.24"
    },
    "autoload": {
        "psr-4": {"Baconfy\\Core\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {
            "Baconfy\\Core\\Tests\\": "tests/",
            "Baconfy\\Core\\Tests\\Fixtures\\Notes\\": "tests/Fixtures/notes/src/",
            "Baconfy\\Core\\Tests\\Fixtures\\Broken\\": "tests/Fixtures/broken/src/"
        }
    },
    "extra": {
        "laravel": {"providers": ["Baconfy\\Core\\CoreServiceProvider"]}
    },
    "scripts": {
        "lint": ["pint --parallel"],
        "lint:check": ["pint --parallel --test"],
        "types:check": ["phpstan analyse"],
        "test": [
            "@lint:check",
            "@types:check",
            "pest"
        ]
    },
    "config": {
        "allow-plugins": {"pestphp/pest-plugin": true}
    }
}
